{
  "name": "clearpath-supabase-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "docker exec -i supabase_db_clearpath-local psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/six_house_rls.sql",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "deck:build": "node scripts/build-clearpath-sales-pptx.mjs",
    "video:voiceover": "node scripts/generate-sales-video-voiceover.mjs",
    "video:preview": "remotion preview remotion/index.jsx",
    "video:render": "remotion render remotion/index.jsx ClearPathSalesVideo public/videos/clearpath-sales-video.mp4",
    "video:render:voiceover": "remotion render remotion/index.jsx ClearPathSalesVideo public/videos/clearpath-sales-video.mp4 --props='{\"includeVoiceover\":true}'",
    "video:still": "remotion still remotion/index.jsx ClearPathSalesVideo public/videos/clearpath-sales-poster.png --frame=0",
    "sample:seed": "node scripts/sample-data/seed.mjs",
    "sample:attach-user": "node scripts/sample-data/attach-user.mjs",
    "sample:validate": "node scripts/sample-data/validate.mjs",
    "sample:remove": "node scripts/sample-data/remove.mjs",
    "migration:inspect": "node scripts/migration/cli.mjs inspect",
    "migration:package-validate": "node scripts/migration/source-package.mjs",
    "migration:validate": "node scripts/migration/cli.mjs validate",
    "migration:import": "node scripts/migration/cli.mjs import",
    "migration:reconcile": "node scripts/migration/cli.mjs reconcile",
    "migration:rollback": "node scripts/migration/cli.mjs rollback",
    "readiness:check": "node scripts/readiness/readiness.mjs",
    "operations:health": "node scripts/operations/health-check.mjs",
    "operations:restore-drill": "node scripts/operations/restore-drill.mjs",
    "verify": "npm test && npm run lint && npm run typecheck && npm run build && npm audit --omit=dev --audit-level=high",
    "test:ui:sample": "node scripts/sample-data/ui-smoke.mjs",
    "preview": "vite preview"
  },
