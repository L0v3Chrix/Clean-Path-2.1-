{
  "name": "ChoreTemplate",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "e.g. Kitchen Cleaning, Lawn Mowing"
    },
    "description": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "enum": [
        "kitchen",
        "bathroom",
        "living_room",
        "yard",
        "laundry",
        "common_area",
        "trash",
        "bedroom",
        "other"
      ],
      "default": "common_area"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "estimated_minutes": {
      "type": "number",
      "default": 30
    },
    "instructions": {
      "type": "string"
    },
    "requires_verification": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organization_id",
    "name"
  ]
}