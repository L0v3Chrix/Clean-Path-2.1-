{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization/operator name"
    },
    "housing_type": {
      "type": "string",
      "description": "Type of housing (self-defined by operator)"
    },
    "narr_level": {
      "type": "string",
      "enum": [
        "I",
        "II",
        "III",
        "IV",
        "not_applicable"
      ],
      "description": "NARR level of support"
    },
    "state": {
      "type": "string"
    },
    "narr_affiliate": {
      "type": "string",
      "description": "State NARR affiliate (e.g. TROHN for Texas)"
    },
    "mission_statement": {
      "type": "string"
    },
    "vision_statement": {
      "type": "string"
    },
    "recovery_pathways": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supported recovery pathways"
    },
    "harm_reduction_enabled": {
      "type": "boolean",
      "default": false
    },
    "logo_url": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "trial"
      ],
      "default": "trial"
    },
    "house_rules": {
      "type": "string",
      "description": "Custom house rules and guidelines shown to residents during intake"
    }
  },
  "required": [
    "name"
  ]
}