{
  "name": "ResidentMilestone",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "intake",
        "sobriety_date",
        "phase_change",
        "life_skills",
        "employment",
        "housing_goal",
        "medical",
        "legal",
        "family",
        "graduation",
        "relapse",
        "other",
        "status_change",
        "interview_completed",
        "care_plan_update"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "phase_from": {
      "type": "string"
    },
    "phase_to": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "Whether this was added manually by staff or auto-logged by the system"
    },
    "staff_annotation": {
      "type": "string",
      "description": "Staff note added to any timeline event"
    },
    "annotated_by": {
      "type": "string"
    },
    "annotated_at": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "date",
    "type",
    "title"
  ]
}