{
  "name": "TaskLog",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "missed",
        "rescheduled",
        "excused"
      ],
      "default": "completed"
    },
    "rescheduled_date": {
      "type": "string",
      "format": "date"
    },
    "logged_by_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "resident_id",
    "log_date",
    "outcome"
  ]
}