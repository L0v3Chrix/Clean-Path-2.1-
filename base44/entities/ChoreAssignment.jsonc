{
  "name": "ChoreAssignment",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "chore_id": {
      "type": "string",
      "description": "Linked ChoreTemplate id"
    },
    "chore_name": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "resident_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "week_label": {
      "type": "string",
      "description": "e.g. Week of May 12"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "verified",
        "missed"
      ],
      "default": "pending"
    },
    "completed_at": {
      "type": "string"
    },
    "verified_by_name": {
      "type": "string"
    },
    "verified_at": {
      "type": "string"
    },
    "staff_notes": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "estimated_minutes": {
      "type": "number"
    },
    "instructions": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "chore_name",
    "resident_id",
    "resident_name",
    "due_date"
  ]
}