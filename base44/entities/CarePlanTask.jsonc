{
  "name": "CarePlanTask",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "goal_id": {
      "type": "string",
      "description": "Parent goal (optional)"
    },
    "organization_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "once",
        "daily",
        "weekly",
        "biweekly",
        "monthly"
      ],
      "default": "once"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "assigned_to_id": {
      "type": "string",
      "description": "Staff member user ID"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "title"
  ]
}