{
  "name": "Location",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Parent organization"
    },
    "name": {
      "type": "string",
      "description": "Property/house name"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "housing_type": {
      "type": "string",
      "description": "sober living, transitional, recovery residence, harm reduction, multifamily, etc."
    },
    "narr_level": {
      "type": "string",
      "enum": [
        "I",
        "II",
        "III",
        "IV",
        "not_applicable"
      ]
    },
    "total_beds": {
      "type": "number"
    },
    "occupied_beds": {
      "type": "number"
    },
    "house_manager_id": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "organization_id"
  ]
}