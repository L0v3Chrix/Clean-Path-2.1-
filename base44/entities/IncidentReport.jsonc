{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "resident_id": {
      "type": "string"
    },
    "reported_by_id": {
      "type": "string"
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "incident_time": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "relapse",
        "overdose",
        "behavioral",
        "medical",
        "property_damage",
        "rule_violation",
        "altercation",
        "elopement",
        "other"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "description": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    },
    "follow_up_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_review",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "naloxone_used": {
      "type": "boolean",
      "default": false
    },
    "ems_called": {
      "type": "boolean",
      "default": false
    },
    "confidential": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "organization_id",
    "location_id",
    "incident_date",
    "type",
    "description"
  ]
}