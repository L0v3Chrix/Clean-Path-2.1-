{
  "name": "Medication",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Medication name"
    },
    "generic_name": {
      "type": "string"
    },
    "dosage": {
      "type": "string",
      "description": "e.g. 10mg"
    },
    "form": {
      "type": "string",
      "enum": [
        "tablet",
        "capsule",
        "liquid",
        "injection",
        "patch",
        "inhaler",
        "topical",
        "other"
      ],
      "default": "tablet"
    },
    "route": {
      "type": "string",
      "enum": [
        "oral",
        "sublingual",
        "injection",
        "topical",
        "inhalation",
        "other"
      ],
      "default": "oral"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "once_daily",
        "twice_daily",
        "three_times_daily",
        "four_times_daily",
        "every_morning",
        "every_evening",
        "weekly",
        "as_needed",
        "other"
      ],
      "default": "once_daily"
    },
    "scheduled_times": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "HH:MM times for each scheduled dose, e.g. ['08:00','20:00']"
    },
    "prescriber": {
      "type": "string"
    },
    "pharmacy": {
      "type": "string"
    },
    "rx_number": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Leave blank if ongoing"
    },
    "instructions": {
      "type": "string",
      "description": "Take with food, avoid alcohol, etc."
    },
    "controlled_substance": {
      "type": "boolean",
      "default": false
    },
    "mat_medication": {
      "type": "boolean",
      "default": false,
      "description": "Medication-Assisted Treatment"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "discontinued",
        "completed"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "name",
    "dosage",
    "frequency"
  ]
}