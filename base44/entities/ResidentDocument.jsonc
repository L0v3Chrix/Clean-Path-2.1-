{
  "name": "ResidentDocument",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "consent_form",
        "resident_agreement",
        "house_rules",
        "intake_assessment",
        "photo_id",
        "insurance_card",
        "release_of_information",
        "recovery_plan",
        "drug_test_result",
        "medication_log",
        "tb_test",
        "other"
      ]
    },
    "label": {
      "type": "string",
      "description": "Custom label override"
    },
    "file_url": {
      "type": "string"
    },
    "signed_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Leave blank if non-expiring"
    },
    "status": {
      "type": "string",
      "enum": [
        "current",
        "expiring_soon",
        "expired",
        "missing"
      ],
      "default": "missing"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "resident_id",
    "document_type"
  ]
}