{
  "name": "ChatChannel",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string",
      "description": "If house-specific, link to a Location id."
    },
    "name": {
      "type": "string"
    },
    "emoji": {
      "type": "string",
      "description": "Optional emoji prefix e.g. \ud83c\udfe0 \ud83c\udf10 \ud83d\udccb"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "public",
        "private",
        "direct",
        "management"
      ],
      "default": "public",
      "description": "Sidebar grouping: public, private, direct messages, management"
    },
    "type": {
      "type": "string",
      "enum": [
        "house",
        "general",
        "resources",
        "announcements",
        "management",
        "outreach",
        "foundation",
        "direct",
        "custom"
      ],
      "description": "Channel purpose/type"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "public",
        "residents_and_staff",
        "staff_only",
        "management_only"
      ],
      "default": "residents_and_staff"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_locked": {
      "type": "boolean",
      "default": false,
      "description": "Read-only / archived house channel"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "created_by_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "category",
    "organization_id"
  ]
}