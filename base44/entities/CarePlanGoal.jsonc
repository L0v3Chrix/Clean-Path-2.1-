{
  "name": "CarePlanGoal",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "term": {
      "type": "string",
      "enum": [
        "short_term",
        "long_term"
      ],
      "description": "Short-term (\u226490 days) or long-term (>90 days)"
    },
    "category": {
      "type": "string",
      "enum": [
        "sobriety",
        "employment",
        "housing",
        "education",
        "mental_health",
        "physical_health",
        "family",
        "legal",
        "financial",
        "social",
        "spiritual",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "on_hold",
        "discontinued"
      ],
      "default": "not_started"
    },
    "progress_notes": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "resident_id",
    "term",
    "category",
    "title"
  ]
}