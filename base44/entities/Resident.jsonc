{
  "name": "Resident",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Linked platform user account"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "intake_date": {
      "type": "string",
      "format": "date"
    },
    "exit_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "applicant",
        "active",
        "on_leave",
        "exited",
        "alumni"
      ],
      "default": "applicant"
    },
    "room": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "sober_date": {
      "type": "string",
      "format": "date"
    },
    "recovery_pathway": {
      "type": "string",
      "description": "12-step, SMART, faith-based, MAT, harm reduction, other"
    },
    "referred_by": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "consent_signed": {
      "type": "boolean",
      "default": false
    },
    "resident_agreement_signed": {
      "type": "boolean",
      "default": false
    },
    "background_check_status": {
      "type": "string",
      "enum": [
        "not_started",
        "pending",
        "clear",
        "review_required",
        "denied"
      ],
      "default": "not_started",
      "description": "Status of background check screening"
    },
    "background_check_consent": {
      "type": "boolean",
      "default": false,
      "description": "Applicant consented to background check"
    },
    "background_check_date": {
      "type": "string",
      "format": "date",
      "description": "Date background check was initiated"
    },
    "background_check_notes": {
      "type": "string",
      "description": "Staff notes on background check results"
    },
    "gender_identity": {
      "type": "string",
      "enum": [
        "man",
        "woman",
        "non_binary",
        "genderqueer",
        "genderfluid",
        "agender",
        "two_spirit",
        "transgender_man",
        "transgender_woman",
        "questioning",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Gender identity \u2014 trauma-informed, self-identified"
    },
    "gender_identity_other": {
      "type": "string",
      "description": "Self-described gender identity if 'other' selected"
    },
    "pronouns": {
      "type": "string",
      "enum": [
        "he_him",
        "she_her",
        "they_them",
        "he_they",
        "she_they",
        "ze_zir",
        "xe_xem",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Preferred pronouns"
    },
    "pronouns_other": {
      "type": "string",
      "description": "Self-described pronouns if 'other' selected"
    },
    "sexual_orientation": {
      "type": "string",
      "enum": [
        "heterosexual_straight",
        "gay",
        "lesbian",
        "bisexual",
        "pansexual",
        "asexual",
        "queer",
        "questioning",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Sexual orientation \u2014 voluntary, kept confidential"
    },
    "sexual_orientation_other": {
      "type": "string",
      "description": "Self-described orientation if 'other' selected"
    },
    "transition_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "considering",
        "socially_transitioned",
        "medically_transitioning",
        "medically_transitioned",
        "prefer_not_to_answer"
      ],
      "description": "Gender transition status \u2014 used to ensure affirming care and appropriate housing placement"
    },
    "race": {
      "type": "string",
      "enum": [
        "american_indian_alaska_native",
        "asian",
        "black_african_american",
        "hispanic_latino",
        "middle_eastern_north_african",
        "native_hawaiian_pacific_islander",
        "white",
        "multiracial",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Race \u2014 voluntary, used for equitable service reporting"
    },
    "race_other": {
      "type": "string",
      "description": "Self-described race if 'other' selected"
    },
    "ethnicity": {
      "type": "string",
      "enum": [
        "hispanic_latino",
        "not_hispanic_latino",
        "prefer_not_to_answer"
      ],
      "description": "Ethnicity (Hispanic/Latino origin)"
    },
    "primary_language": {
      "type": "string",
      "enum": [
        "english",
        "spanish",
        "arabic",
        "chinese_mandarin",
        "chinese_cantonese",
        "french",
        "haitian_creole",
        "hindi",
        "hmong",
        "korean",
        "portuguese",
        "russian",
        "somali",
        "tagalog",
        "vietnamese",
        "american_sign_language",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Primary spoken / preferred language"
    },
    "primary_language_other": {
      "type": "string",
      "description": "Language if 'other' selected"
    },
    "interpreter_needed": {
      "type": "boolean",
      "default": false,
      "description": "Resident needs language interpretation services"
    },
    "religion_spirituality": {
      "type": "string",
      "enum": [
        "christian",
        "catholic",
        "protestant",
        "evangelical",
        "mormon_lds",
        "jewish",
        "muslim",
        "buddhist",
        "hindu",
        "native_spiritual",
        "spiritual_not_religious",
        "agnostic",
        "atheist",
        "prefer_not_to_answer",
        "other"
      ],
      "description": "Religious or spiritual affiliation \u2014 used to align recovery supports"
    },
    "religion_other": {
      "type": "string",
      "description": "Self-described religion if 'other' selected"
    },
    "veteran_status": {
      "type": "string",
      "enum": [
        "not_a_veteran",
        "active_duty",
        "veteran",
        "national_guard_reserve",
        "prefer_not_to_answer"
      ],
      "description": "Military / veteran status"
    },
    "disability_status": {
      "type": "string",
      "enum": [
        "none",
        "physical",
        "cognitive_intellectual",
        "mental_health",
        "sensory_vision_hearing",
        "multiple",
        "prefer_not_to_answer"
      ],
      "description": "Disability status \u2014 used to ensure appropriate accommodations"
    },
    "housing_status_at_intake": {
      "type": "string",
      "enum": [
        "housed",
        "couch_surfing",
        "transitional_housing",
        "shelter",
        "vehicle",
        "unsheltered",
        "incarcerated",
        "prefer_not_to_answer"
      ],
      "description": "Housing situation immediately before intake"
    },
    "trauma_informed_notes": {
      "type": "string",
      "description": "Staff notes on trauma history, triggers, or cultural considerations \u2014 kept strictly confidential"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}