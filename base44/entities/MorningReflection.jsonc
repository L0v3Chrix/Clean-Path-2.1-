{
  "name": "MorningReflection",
  "type": "object",
  "properties": {
    "resident_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "mood": {
      "type": "number",
      "description": "1-5 scale: 1=Very Low, 2=Low, 3=Okay, 4=Good, 5=Great"
    },
    "physical_wellbeing": {
      "type": "number",
      "description": "1-5 scale: 1=Very Poor, 2=Poor, 3=Fair, 4=Good, 5=Excellent \u2014 physical health today"
    },
    "sleep_quality": {
      "type": "number",
      "description": "1-5 scale: 1=Very Poor, 2=Poor, 3=Fair, 4=Good, 5=Excellent"
    },
    "sleep_hours": {
      "type": "number"
    },
    "daily_goal": {
      "type": "string"
    },
    "gratitude": {
      "type": "string"
    },
    "concerns": {
      "type": "string"
    },
    "flagged_for_support": {
      "type": "boolean",
      "default": false
    },
    "flag_reason": {
      "type": "string",
      "description": "Auto-generated reason explaining why this check-in was flagged"
    },
    "staff_reviewed": {
      "type": "boolean",
      "default": false,
      "description": "Case manager has reviewed this flagged check-in"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    },
    "barc10_answers": {
      "type": "object",
      "description": "Keys are question indices (0-9), values are 0-4 scores"
    },
    "barc10_score": {
      "type": "number",
      "description": "Total BARC-10 score (0-40)"
    },
    "qol_answers": {
      "type": "object",
      "description": "Keys are question indices (0-6), values are 1-5 scores"
    },
    "qol_score": {
      "type": "number",
      "description": "Total QoL score (7-35)"
    }
  },
  "required": [
    "resident_id",
    "log_date",
    "mood",
    "sleep_quality"
  ]
}