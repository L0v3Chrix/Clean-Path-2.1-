{
  "name": "StaffMember",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Locations this staff member oversees"
    },
    "user_id": {
      "type": "string",
      "description": "Linked platform user account"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "platform_admin",
        "owner",
        "director",
        "house_manager",
        "peer_support",
        "case_manager",
        "staff",
        "volunteer"
      ],
      "description": "Platform role determining access level"
    },
    "title": {
      "type": "string",
      "description": "Job title"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "lived_experience": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "role",
    "organization_id"
  ]
}