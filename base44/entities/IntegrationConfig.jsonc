{
  "name": "IntegrationConfig",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "integration_name": {
      "type": "string",
      "description": "e.g. Stripe, Twilio, QuickBooks, Mailchimp"
    },
    "integration_type": {
      "type": "string",
      "enum": [
        "payments",
        "sms",
        "accounting",
        "email_marketing",
        "scheduling",
        "telehealth",
        "background_check",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "pending",
        "error"
      ],
      "default": "disconnected"
    },
    "config_notes": {
      "type": "string",
      "description": "Non-sensitive connection notes / webhook URLs"
    },
    "connected_date": {
      "type": "string",
      "format": "date"
    },
    "last_synced": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "integration_name",
    "integration_type"
  ]
}