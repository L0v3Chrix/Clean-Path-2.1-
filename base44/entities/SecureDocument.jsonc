{
  "name": "SecureDocument",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "resident_id": {
      "type": "string",
      "description": "If linked to a resident profile"
    },
    "resident_name": {
      "type": "string",
      "description": "Denormalized for display"
    },
    "folder": {
      "type": "string",
      "enum": [
        "resident_records",
        "management",
        "hr",
        "financial",
        "compliance",
        "legal",
        "intake",
        "other"
      ],
      "default": "other",
      "description": "Logical folder grouping"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "file_name": {
      "type": "string"
    },
    "file_type": {
      "type": "string",
      "description": "MIME type"
    },
    "file_size_kb": {
      "type": "number"
    },
    "access_level": {
      "type": "string",
      "enum": [
        "admin_only",
        "staff_and_admin",
        "all_staff"
      ],
      "default": "staff_and_admin"
    },
    "uploaded_by_name": {
      "type": "string"
    },
    "uploaded_by_id": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "organization_id",
    "title",
    "file_url",
    "folder"
  ]
}