{
  "name": "Shift",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string",
      "description": "Primary staff member on duty"
    },
    "staff_name": {
      "type": "string"
    },
    "shift_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "end_time": {
      "type": "string",
      "description": "HH:MM"
    },
    "role_label": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "on_call"
      ],
      "default": "primary"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "no_show"
      ],
      "default": "scheduled"
    }
  },
  "required": [
    "location_id",
    "staff_id",
    "shift_date",
    "start_time",
    "end_time"
  ]
}